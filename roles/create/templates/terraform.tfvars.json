{
  "cloud_region": "{{ rosa_region }}",
  "account_role_prefix": "{{ rosa_cluster_name }}",
  "operator_role_prefix": "{{ rosa_cluster_name }}",
  "rosa_cluster_name": "{{ rosa_cluster_name }}",
  "ocp_version": "{{ rosa_version }}",
  "compute_machine_type": "{{ rosa_worker_instance_type | default('m5.xlarge') }}",
  "rosa_worker_nodes": {{ rosa_worker_nodes | default(2) }},
  "rosa_admin_username": "{{ rosa_admin_username | default('cluster-admin') }}",
  "rosa_admin_password": "{{ rosa_admin_password | default('') }}",
  "private": {{ rosa_private | default(false) | to_json }},
  "token": "{{ rosa_token }}",
{% if rosa_machine_cidr is defined %}
  "machine_cidr": "{{ rosa_machine_cidr }}",
{% endif %}
  "tags": {
    "cluster-name": "{{ rosa_cluster_name }}"
  }
}
